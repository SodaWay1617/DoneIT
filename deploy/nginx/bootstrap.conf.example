server {
    listen 80;
    server_name DOMAIN_NAME;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    # The existing application remains on :8080 during certificate issuance.
    location / {
        return 503;
    }
}
